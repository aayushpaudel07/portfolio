# Copy this file to .env.local and fill in your EmailJS credentials
# (https://www.emailjs.com/) to enable the contact form to send real emails.
# Without these set, the form falls back to opening the visitor's mail client.

NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
